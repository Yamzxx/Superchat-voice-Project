# ===================================================
# Superchat Voice Assistant - Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# ===================================================

# LLM Providers (Groq is recommended for ultra-fast conversational latency)
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Speech-to-Text (STT) - 'whisper' | 'google'
STT_PROVIDER=whisper
STT_API_KEY=your_stt_or_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Text-to-Speech (TTS) - 'google' | 'elevenlabs' | 'openai'
TTS_PROVIDER=google
TTS_API_KEY=your_google_cloud_tts_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server port (only used for local development, Vercel handles this automatically)
PORT=4000
